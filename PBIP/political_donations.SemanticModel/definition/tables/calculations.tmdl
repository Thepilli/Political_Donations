table calculations
	lineageTag: db24e54d-493f-4f66-8e9d-32d12df6d48d

	/// Sum of all donation amounts in the current filter context.
	measure 'Total Donation' = SUM(F_donations[value])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 12809edc-a3f8-4beb-83c7-617a58cddc7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Number of donation records (transactions).
	measure 'No of Donations' = COUNTROWS(F_donations)
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 74c26fa0-27f1-4603-a1ef-a91e1d67acb1

	/// Distinct number of donors (FO + PO) in the current filter context.
	measure 'No of Donors' = DISTINCTCOUNT(F_donations[donor_key])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 2ba30467-a934-4a87-b992-b0daefb36cba

	/// Total donation amount from companies (PO).
	measure 'Total Donation PO' = CALCULATE([Total Donation], KEEPFILTERS(F_donations[donor_type] = "PO"))
		formatString: #,0
		displayFolder: 2 By Donor Type
		lineageTag: 213cd782-e9b7-4ad6-91ca-fdb319b1d977

		annotation PBI_FormatHint = {"isGeneralNumber":true}

