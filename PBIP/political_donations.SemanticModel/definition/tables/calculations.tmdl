	/// Total amount this donor has given across all parties (ignores any party filter).
	measure 'Donor Total (All Parties)' = CALCULATE([Total Donation], ALL(D_party))
		formatString: #,0
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-000000000028

	/// Number of donation transactions this donor has made across all parties.
	measure 'Donor Donations (All Parties)' = CALCULATE([No of Donations], ALL(D_party))
		formatString: #,0
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-000000000029

	/// Distinct number of parties this donor has funded.
	measure 'Donor No of Parties' = CALCULATE(DISTINCTCOUNT(F_donations[ic]), ALL(D_party))
		formatString: #,0
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-00000000002a

	/// Name of the party that received the largest total from this donor.
	measure 'Donor Top Party' =
			VAR _byParty =
				ADDCOLUMNS(
					CALCULATETABLE(VALUES(D_party[longName]), ALL(D_party)),
					"@amt", [Total Donation]
				)
			RETURN
				MAXX(TOPN(1, _byParty, [@amt], DESC), [longName])
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-00000000002b

	/// Amount this donor gave to their top party.
	measure 'Donor Top Party Amount' =
			MAXX(
				ADDCOLUMNS(
					CALCULATETABLE(VALUES(D_party[longName]), ALL(D_party)),
					"@amt", [Total Donation]
				),
				[@amt]
			)
		formatString: #,0
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-00000000002c

	/// Share of this donor's total giving that went to their top party. 100% = single-party loyalty.
	measure 'Donor Top Party Share' = DIVIDE([Donor Top Party Amount], [Donor Total (All Parties)])
		formatString: #,0.0%
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-00000000002d

	/// Name of the second-highest party this donor funded. Blank if they only gave to one.
	measure 'Donor 2nd Party' =
			VAR _byParty =
				ADDCOLUMNS(
					CALCULATETABLE(VALUES(D_party[longName]), ALL(D_party)),
					"@amt", [Total Donation]
				)
			VAR _ranked =
				ADDCOLUMNS(_byParty, "@rank", RANKX(_byParty, [@amt],, DESC, Dense))
			RETURN
				MAXX(FILTER(_ranked, [@rank] = 2), [longName])
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-00000000002e

	/// Share of this donor's total going to their second-highest party.
	measure 'Donor 2nd Party Share' =
			VAR _total = [Donor Total (All Parties)]
			VAR _byParty =
				ADDCOLUMNS(
					CALCULATETABLE(VALUES(D_party[longName]), ALL(D_party)),
					"@amt", [Total Donation]
				)
			VAR _ranked =
				ADDCOLUMNS(_byParty, "@rank", RANKX(_byParty, [@amt],, DESC, Dense))
			VAR _2ndAmt = MAXX(FILTER(_ranked, [@rank] = 2), [@amt])
			RETURN DIVIDE(_2ndAmt, _total)
		formatString: #,0.0%
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-00000000002f

	/// Rank of the currently selected party within this donor's giving (1 = their top party).
	measure 'Donor Party Rank' =
			VAR _byParty =
				ADDCOLUMNS(
					CALCULATETABLE(VALUES(D_party[longName]), ALL(D_party)),
					"@amt", [Total Donation]
				)
			VAR _thisAmt = [Total Donation]
			RETURN
				IF(NOT ISBLANK(_thisAmt), RANKX(_byParty, [@amt], _thisAmt, DESC, Dense))
		formatString: 0
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-000000000030

	/// Herfindahl-Hirschman Index of this donor's giving across parties. 10 000 = single-party loyal, low = spread across many parties.
	measure 'Donor Party HHI' =
			VAR _total = [Donor Total (All Parties)]
			VAR _t =
				ADDCOLUMNS(
					CALCULATETABLE(VALUES(D_party[longName]), ALL(D_party)),
					"@sq", DIVIDE([Total Donation], _total) ^ 2
				)
			RETURN 10000 * SUMX(_t, [@sq])
		formatString: #,0
		displayFolder: Donor Profile
		lineageTag: c1000000-0000-0000-0000-000000000031

	partition Calculations = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

